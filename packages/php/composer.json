{
    "name": "edm-uk/shopify-rest-to-graphql",
    "description": "Find Shopify REST Admin API calls in a PHP codebase and report the GraphQL operation that replaces each one.",
    "type": "library",
    "license": "MIT",
    "keywords": ["shopify", "graphql", "rest", "migration", "admin-api", "static-analysis"],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "bin": ["bin/shopify-rest-to-graphql"],
    "autoload": {
        "psr-4": {
            "EdmUk\\ShopifyRestToGraphql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdmUk\\ShopifyRestToGraphql\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
